# Postgres — your database connection (Neon, or any Postgres instance)
# Get these from your Neon project dashboard → Connection Details.
# Never commit real values here — this file is an example/template only.
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require&channel_binding=require"
DATABASE_URL_POOLED="postgresql://<user>:<password>@<host>-pooler/<database>?sslmode=require&channel_binding=require"

# Flutterwave (Standard/Hosted Checkout)
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=

# Admin auth — signs admin session cookies. Individual admin accounts
# are created via `npx tsx lib/db/seed-admin.ts <email> <password>`
# (first admin) or Admin -> Settings (subsequent admins).
# Generate a real value with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# DSers integration — order sync + fulfillment webhook
# DSERS_API_URL: base URL for the DSers Open API, e.g. https://openapi.dsers.com
# DSERS_API_KEY: server-side API key/token for your DSers account, sent as a Bearer token
# DSERS_WEBHOOK_SECRET: shared secret you configure in the DSers dashboard's
#   webhook settings; incoming webhooks must echo it back in the
#   "x-dsers-webhook-secret" header. Generate one with: openssl rand -hex 32
DSERS_API_URL=
DSERS_API_KEY=
DSERS_WEBHOOK_SECRET=

# Email notifications (optional — order lifecycle emails no-op if unset)
RESEND_API_KEY=
EMAIL_FROM="SWD <orders@yourdomain.com>"

# SMS / WhatsApp notifications via Twilio (optional — each channel no-ops
# independently if its vars are unset). Get these from the Twilio console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Product image hosting via Vercel Blob (optional — admin product images
# fall back to local placeholder SVGs if unset). Created automatically when
# you add Vercel Blob storage to this project; copy the token from
# Vercel → Storage → your Blob store → .env.local tab.
BLOB_READ_WRITE_TOKEN=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
