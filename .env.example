# Postgres — your database connection (Neon Postgres in production)
# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored and must never be committed.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&channel_binding=require"
DATABASE_URL_POOLED="postgresql://user:password@host-pooler/dbname?sslmode=require&channel_binding=require"

# Flutterwave (Standard/Hosted Checkout)
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=

# Admin auth — signs admin session cookies. Individual admin accounts
# are created via `npx tsx lib/db/seed-admin.ts <email> <password>`
# (first admin) or Admin -> Settings (subsequent admins).
# Generate a strong random value, e.g.: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Email notifications (optional — order lifecycle emails no-op if unset)
RESEND_API_KEY=
EMAIL_FROM="SWD <orders@yourdomain.com>"

# DSers fulfillment integration (optional — DSers sync no-ops if unset)
DSERS_API_URL=
DSERS_API_KEY=
DSERS_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
